{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "verifi": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false,
          "skipTests": true,
          "type": "component"
        },
        "@schematics/angular:pipe": {
          "standalone": false,
          "skipTests": true,
          "typeSeparator": "."
        },
        "@schematics/angular:service": {
          "skipTests": true,
          "type": "service"
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:module": {
          "standalone": false,
          "type": "module",
          "typeSeparator": "."
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/assets",
              "src/robots.txt",
              "src/sitemap.xml"
            ],
            "styles": [
              "src/styles/styles.css",
              "src/styles/sliderToggle.css",
              "src/styles/meterDisplays.css",
              "src/styles/contentTabs.css",
              "src/styles/contentContainers.css",
              "src/styles/sectionHeaders.css",
              "src/styles/sidebar.css",
              "src/styles/tables.css",
              "src/styles/forms.css",
              "src/styles/popupsWindows.css",
              "src/styles/alerts.css",
              "src/styles/htmlElements.css",
              "src/styles/typography.css",
              "src/styles/buttons.css",
              "src/styles/banners.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles/printing.css",
              "src/styles/plotly.css",
              "src/styles/dataManagement.css",
              "src/styles/reports.css",
              "src/app/ux-prototypes/styles/prototype-reset.css"
            ],
            "scripts": [
              "node_modules/plotly.js-dist-min/plotly.min.js",
              "node_modules/@popperjs/core/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.bundle.js"
            ],
            "allowedCommonJsDependencies": [
              "lodash",
              "xlsx",
              "exceljs",
              "jstat",
              "papaparse"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "testing": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "assets": [
                "src/assets"
              ],
              "styles": [
                "src/styles/styles.css",
                "src/styles/sliderToggle.css",
                "src/styles/meterDisplays.css",
                "src/styles/contentTabs.css",
                "src/styles/contentContainers.css",
                "src/styles/sectionHeaders.css",
                "src/styles/sidebar.css",
                "src/styles/tables.css",
                "src/styles/forms.css",
                "src/styles/popupsWindows.css",
                "src/styles/alerts.css",
                "src/styles/htmlElements.css",
                "src/styles/typography.css",
                "src/styles/buttons.css",
                "src/styles/banners.css",
                "node_modules/bootstrap/dist/css/bootstrap.min.css",
                "src/styles/printing.css"
              ],
              "scripts": []
            },
            "dev-srv": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev-srv.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "electron": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.electron.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "verifi:build",
            "proxyConfig": "src/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "verifi:build:production"
            },
            "development": {
              "buildTarget": "verifi:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "verifi:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "verifi:build:testing",
            "tsConfig": "tsconfig.spec.json",
            "reporters": [
              "verbose"
            ],
            "exclude": [
              "**/*.browser.spec.ts"
            ]
          }
        },
        "test-browser": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "verifi:build:testing",
            "tsConfig": "tsconfig.browser-spec.json",
            "reporters": [
              "verbose"
            ],
            "include": [
              "**/*.browser.spec.ts"
            ],
            "browsers": [
              "chromium"
            ]
          }
        },
        "test-coverage": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "verifi:build:testing",
            "tsConfig": "tsconfig.coverage-spec.json",
            "runnerConfig": "vitest.coverage.config.ts",
            "reporters": [
              "verbose"
            ],
            "include": [
              "**/*.spec.ts"
            ],
            "exclude": [
              "src/app/web-workers/run-worker.browser.spec.ts"
            ],
            "browsers": [
              "chromium"
            ],
            "coverage": true,
            "coverageInclude": [
              "src/app/calculations/**/*.ts",
              "src/app/indexedDB/**/*.ts",
              "src/app/web-workers/**/*.ts"
            ],
            "coverageExclude": [
              "src/**/*.spec.ts",
              "src/app/web-workers/testing/**"
            ],
            "coverageReporters": [
              "text-summary",
              "html"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
